# copy to .env and edit — loaded automatically by `npm start` (real env vars win)
PORT=3000

# analytics (both URL + WEBSITE_ID required; leave empty to disable)
ANALYTICS_URL=
ANALYTICS_WEBSITE_ID=
ANALYTICS_RECORDER=false
# ANALYTICS_SCRIPT=script.js
# ANALYTICS_RECORDER_SCRIPT=recorder.js

# abuse limits
MAX_ROOMS=200
MAX_CONN_PER_IP=12
ROOMS_PER_IP_PER_MIN=6
